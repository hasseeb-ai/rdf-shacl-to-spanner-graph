@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <http://example.org/fintech/> .

ex:FintechOntology a owl:Ontology ;
    rdfs:label "Fintech Compliance Ontology" ;
    rdfs:comment "An OWL ontology for monitoring account structures, ownership, and partner networks." .

# Classes
ex:Account a owl:Class .

ex:PersonalAccount a owl:Class ;
    rdfs:subClassOf ex:Account ;
    owl:disjointWith ex:CorporateAccount .

ex:CorporateAccount a owl:Class ;
    rdfs:subClassOf ex:Account .

ex:Party a owl:Class .

ex:Person a owl:Class ;
    rdfs:subClassOf ex:Party ;
    owl:disjointWith ex:Organization .

ex:Organization a owl:Class ;
    rdfs:subClassOf ex:Party .

# Equivalent Classes
ex:HighRiskAccount a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            ex:Account
            [
                a owl:Restriction ;
                owl:onProperty ex:accountBalance ;
                owl:someValuesFrom [
                    a rdfs:Datatype ;
                    owl:onDatatype xsd:decimal ;
                    owl:withRestrictions ( [ xsd:minExclusive 100000.00 ] )
                ]
            ]
        )
    ] .

# Restrictions
ex:PersonalAccount rdfs:subClassOf
    [
        a owl:Restriction ;
        owl:onProperty ex:hasOwner ;
        owl:allValuesFrom ex:Person
    ] ,
    [
        a owl:Restriction ;
        owl:onProperty ex:hasSignatory ;
        owl:maxCardinality "3"^^xsd:nonNegativeInteger
    ] .

ex:CorporateAccount rdfs:subClassOf
    [
        a owl:Restriction ;
        owl:onProperty ex:hasOwner ;
        owl:allValuesFrom ex:Organization
    ] ,
    [
        a owl:Restriction ;
        owl:onProperty ex:hasOwner ;
        owl:cardinality "1"^^xsd:nonNegativeInteger
    ] .

# Properties
ex:hasOwner a owl:ObjectProperty .

ex:hasSignatory a owl:ObjectProperty ;
    rdfs:domain ex:PersonalAccount ;
    rdfs:range ex:Person .

ex:isPartnerOf a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:domain ex:Organization ;
    rdfs:range ex:Organization .

ex:subAccountOf a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:domain ex:Account ;
    rdfs:range ex:Account .

ex:ownsAccount a owl:ObjectProperty ;
    owl:inverseOf ex:hasOwner .

ex:accountBalance a owl:DatatypeProperty ;
    rdfs:domain ex:Account ;
    rdfs:range xsd:decimal .
