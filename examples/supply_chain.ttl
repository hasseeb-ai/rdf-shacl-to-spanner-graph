@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <http://example.org/supplychain/> .

ex:SupplyChainOntology a owl:Ontology ;
    rdfs:label "Supply Chain and Logistics Inventory Ontology" ;
    rdfs:comment "An OWL ontology modeling global supply chain networks, warehouses, parts hierarchies, shipments, and carrier routes." .

# ==========================================
# 1. CLASSES
# ==========================================

ex:Asset a owl:Class .

# Location Taxonomy
ex:Location a owl:Class ;
    rdfs:subClassOf ex:Asset .

ex:Warehouse a owl:Class ;
    rdfs:subClassOf ex:Location ;
    owl:disjointWith ex:ManufacturingPlant .

ex:ManufacturingPlant a owl:Class ;
    rdfs:subClassOf ex:Location .

ex:SupplierFacility a owl:Class ;
    rdfs:subClassOf ex:Location .

# Item Taxonomy
ex:Item a owl:Class ;
    rdfs:subClassOf ex:Asset .

ex:RawMaterial a owl:Class ;
    rdfs:subClassOf ex:Item ;
    owl:disjointWith ex:SubAssembly .

ex:SubAssembly a owl:Class ;
    rdfs:subClassOf ex:Item ;
    owl:disjointWith ex:FinishedProduct .

ex:FinishedProduct a owl:Class ;
    rdfs:subClassOf ex:Item .

# Logistics Entities
ex:Shipment a owl:Class .
ex:Carrier a owl:Class .

# Equivalent Class: HighValueItem
ex:HighValueItem a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            ex:Item
            [
                a owl:Restriction ;
                owl:onProperty ex:unitCost ;
                owl:someValuesFrom [
                    a rdfs:Datatype ;
                    owl:onDatatype xsd:decimal ;
                    owl:withRestrictions ( [ xsd:minExclusive 5000.00 ] )
                ]
            ]
        )
    ] .

# ==========================================
# 2. OBJECT PROPERTIES
# ==========================================

ex:partOf a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:domain ex:Item ;
    rdfs:range ex:Item .

ex:hasPart a owl:ObjectProperty ;
    owl:inverseOf ex:partOf .

ex:suppliedBy a owl:ObjectProperty ;
    rdfs:domain ex:RawMaterial ;
    rdfs:range ex:SupplierFacility .

ex:manufacturedAt a owl:ObjectProperty ;
    rdfs:domain ex:FinishedProduct ;
    rdfs:range ex:ManufacturingPlant .

ex:storedIn a owl:ObjectProperty ;
    rdfs:domain ex:Item ;
    rdfs:range ex:Warehouse .

ex:shippedVia a owl:ObjectProperty ;
    rdfs:domain ex:Shipment ;
    rdfs:range ex:Carrier .

ex:origin a owl:ObjectProperty ;
    rdfs:domain ex:Shipment ;
    rdfs:range ex:Location .

ex:destination a owl:ObjectProperty ;
    rdfs:domain ex:Shipment ;
    rdfs:range ex:Location .

# Symmetric Property: Route connection between locations
ex:connectedTo a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:domain ex:Location ;
    rdfs:range ex:Location .

# ==========================================
# 3. DATATYPE PROPERTIES
# ==========================================

ex:unitCost a owl:DatatypeProperty ;
    rdfs:domain ex:Item ;
    rdfs:range xsd:decimal .

ex:quantityInStock a owl:DatatypeProperty ;
    rdfs:domain ex:Item ;
    rdfs:range xsd:integer .

ex:locationCode a owl:DatatypeProperty ;
    rdfs:domain ex:Location ;
    rdfs:range xsd:string .

ex:carrierName a owl:DatatypeProperty ;
    rdfs:domain ex:Carrier ;
    rdfs:range xsd:string .

ex:shipmentTrackingNumber a owl:DatatypeProperty ;
    rdfs:domain ex:Shipment ;
    rdfs:range xsd:string .

ex:shipmentDate a owl:DatatypeProperty ;
    rdfs:domain ex:Shipment ;
    rdfs:range xsd:dateTime .

# ==========================================
# 4. CLASS RESTRICTIONS
# ==========================================

ex:FinishedProduct rdfs:subClassOf
    [
        a owl:Restriction ;
        owl:onProperty ex:manufacturedAt ;
        owl:someValuesFrom ex:ManufacturingPlant
    ] .

ex:Warehouse rdfs:subClassOf
    [
        a owl:Restriction ;
        owl:onProperty ex:locationCode ;
        owl:cardinality "1"^^xsd:nonNegativeInteger
    ] .
