@prefix ex: <http://example.org/knowledgebase/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ArticleShape a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:class ex:Category ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ex:categorizedUnder ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path ex:title ],
        [ sh:class ex:Article ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path ex:linkedWith ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path ex:wordCount ],
        [ sh:class ex:Article ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path ex:references ],
        [ sh:class ex:Author ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ex:hasAuthor ] ;
    sh:targetClass ex:Article .

ex:AuthorShape a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path ex:username ] ;
    sh:targetClass ex:Author .

ex:CategoryShape a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path ex:categoryName ],
        [ sh:class ex:Category ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path ex:subCategoryOf ] ;
    sh:targetClass ex:Category .

ex:EntityShape a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:targetClass ex:Entity .

