@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <http://example.org/test/multiple_inheritance/> .

ex:MultipleInheritanceOntology a owl:Ontology ;
    rdfs:label "Multiple Inheritance & Disambiguation Test Ontology" ;
    rdfs:comment "Tests multiple inheritance (diamond pattern), multi-ancestor label accumulation, and column disambiguation when parent classes declare overlapping local names." .

# =============================================================================
# Class Taxonomy (Diamond Multiple Inheritance):
# Person (Root Class)
#   ├── Employee (Subclass of Person)
#   │     └── TeachingAssistant (Subclass of BOTH Employee and Student)
#   └── Student (Subclass of Person)
#         └── TeachingAssistant (Subclass of BOTH Employee and Student)
#
# Concrete Leaf Classes:
# - RegularEmployee (Subclass of Employee)
# - UndergraduateStudent (Subclass of Student)
# - TeachingAssistant (Subclass of Employee AND Student)
# =============================================================================

ex:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "Root abstract class." .

ex:Employee a owl:Class ;
    rdfs:subClassOf ex:Person ;
    rdfs:label "Employee" .

ex:Student a owl:Class ;
    rdfs:subClassOf ex:Person ;
    rdfs:label "Student" .

ex:RegularEmployee a owl:Class ;
    rdfs:subClassOf ex:Employee ;
    rdfs:label "Regular Employee" ;
    rdfs:comment "Concrete leaf class." .

ex:UndergraduateStudent a owl:Class ;
    rdfs:subClassOf ex:Student ;
    rdfs:label "Undergraduate Student" ;
    rdfs:comment "Concrete leaf class." .

ex:TeachingAssistant a owl:Class ;
    rdfs:subClassOf ex:Employee , ex:Student ;
    rdfs:label "Teaching Assistant" ;
    rdfs:comment "Concrete leaf class with multiple inheritance. Inherits all Person, Employee, and Student properties. NODE TABLE must declare all four labels." .

# =============================================================================
# Datatype Properties across the Diamond:
# - Person properties: fullName, nationalId
# - Employee properties: employeeId, hourlyRate, internalCode
# - Student properties: studentNumber, gpa, internalCode (Collision with Employee!)
# - TeachingAssistant specific: stipendAmount, assignedCourseCode
# =============================================================================

ex:fullName a owl:DatatypeProperty ;
    rdfs:domain ex:Person ;
    rdfs:range xsd:string ;
    rdfs:label "Full Name" ;
    rdfs:comment "Propagates to all concrete classes (RegularEmployee, UndergraduateStudent, TeachingAssistant)." .

ex:nationalId a owl:DatatypeProperty ;
    rdfs:domain ex:Person ;
    rdfs:range xsd:string ;
    rdfs:label "National ID" .

ex:employeeId a owl:DatatypeProperty ;
    rdfs:domain ex:Employee ;
    rdfs:range xsd:string ;
    rdfs:label "Employee ID" ;
    rdfs:comment "Propagates to RegularEmployee and TeachingAssistant." .

ex:hourlyRate a owl:DatatypeProperty ;
    rdfs:domain ex:Employee ;
    rdfs:range xsd:decimal ;
    rdfs:label "Hourly Rate" .

ex:employeeCode a owl:DatatypeProperty ;
    rdfs:domain ex:Employee ;
    rdfs:range xsd:string ;
    rdfs:label "Employee Internal Code" .

ex:studentNumber a owl:DatatypeProperty ;
    rdfs:domain ex:Student ;
    rdfs:range xsd:string ;
    rdfs:label "Student Number" ;
    rdfs:comment "Propagates to UndergraduateStudent and TeachingAssistant." .

ex:gpa a owl:DatatypeProperty ;
    rdfs:domain ex:Student ;
    rdfs:range xsd:decimal ;
    rdfs:label "Grade Point Average" .

ex:studentCode a owl:DatatypeProperty ;
    rdfs:domain ex:Student ;
    rdfs:range xsd:string ;
    rdfs:label "Student Internal Code" .

ex:stipendAmount a owl:DatatypeProperty ;
    rdfs:domain ex:TeachingAssistant ;
    rdfs:range xsd:decimal ;
    rdfs:label "TA Stipend Amount" ;
    rdfs:comment "Bottom-up isolation: Belongs strictly to TeachingAssistant." .

ex:assignedCourseCode a owl:DatatypeProperty ;
    rdfs:domain ex:TeachingAssistant ;
    rdfs:range xsd:string ;
    rdfs:label "Assigned Course Code" .
